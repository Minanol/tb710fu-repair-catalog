[Unit]
Description=Fcitx 5 input method for TB710FU (IBus name released to GNOME ibus)
PartOf=graphical-session.target
After=graphical-session-pre.target

[Service]
# ibusfrontend 会让 fcitx5 抢占 org.freedesktop.IBus，
# 导致 GNOME 的 text-input 无法使用 ibus 引擎（Droidloom 只能打英文）。
# 这里保留 fcitx5 给 GTK/Qt 应用，但把 IBus 名字让给真正的 ibus-daemon。
ExecStart=/usr/bin/fcitx5 -D -r --disable ibusfrontend
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
